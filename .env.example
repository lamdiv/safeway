# Server only. Never put credentials in frontend code or source control.
HEADWATER_PROVIDER=bedrock
AWS_REGION=us-east-1
HEADWATER_MODEL=us.amazon.nova-2-lite-v1:0
# Option A: Bedrock API key (create locally in the AWS console).
AWS_BEARER_TOKEN_BEDROCK=
# Option B: an existing AWS profile, e.g. after `aws sso login --profile hackathon`.
# AWS_PROFILE=hackathon
# For default-profile / ECS / EC2 / web-identity credentials without an explicit
# profile variable, opt in to credential-chain resolution:
# HEADWATER_AWS_ENABLED=true
# Standard AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN also work.
PORT=4173
# Optional remote access protection. Required if exposing your local server.
HEADWATER_API_TOKEN=

# Optional explicit OpenAI fallback; never selected automatically.
# HEADWATER_PROVIDER=openai
# HEADWATER_MODEL=gpt-5.4
# OPENAI_API_KEY=

# Optional Photon SIP / ElevenLabs test-call integration.
# Configure an eligible Photon line and import its SIP trunk into ElevenLabs first.
ELEVENLABS_API_KEY=
HEADWATER_VOICE_AGENT_ID=
HEADWATER_VOICE_PHONE_ID=
# Comma-separated opt-in test recipients only. Never emergency-service numbers.
HEADWATER_TEST_RECIPIENTS=
